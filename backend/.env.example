# Leave MONGO_URI empty to use an in-memory mongomock DB (dev/testing only, data lost on restart)
MONGO_URI=
MONGO_DB=datapilot
JWT_SECRET=change-me-to-a-long-random-string
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173
# LLM features (NL-to-SQL, narration). Without a key the app still works; AI endpoints return 503.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Share distinct values of low-cardinality, non-PII text columns with the LLM (improves NL-to-SQL). Never full rows.
LLM_SHARE_VALUES=true
SQL_TIMEOUT_S=20
SQL_MAX_ROWS=5000
MAX_UPLOAD_MB=50

# Frontend URL (for OAuth redirect callbacks)
FRONTEND_URL=http://localhost:5173

# Google OAuth (from https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:5173/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (from https://github.com/settings/developers)
# Authorization callback URL: http://localhost:5173/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
